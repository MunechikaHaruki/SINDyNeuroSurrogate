    "_test_hh_sindy": {"description": "テスト専用（tests は名前で引く）。どの実験にも入れないので冊には出ない。", "base": "test_hh", "form": "sindy", "d": 3},
    "_test_hh_hybrid": {"base": "test_hh", "form": "hybrid", "d": 3},
    "_test_hh_ae": {
      "description": "AE の経路を踏むだけなので epochs を切り詰める。",
