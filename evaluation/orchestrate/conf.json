{
  "bases": {
    "traub_grouped": {
      "description": "群ごとに圧縮する（研究の問い grouping-sweep）。単一区画の軌道で学習し、電流は 19 区画の学習（1000 ms × 19）と同じくらいのサンプル数にする。",
      "cell": "traub",
      "form": "hybrid",
      "target": "traub",
      "duration": 9000,
      "library_specs": [
        {"type": "traub_gate_forward"},
        {"type": "traub_gate_backward"},
        {"type": "traub_gate_forward_product"},
        {"type": "traub_gate_backward_product"},
        {"type": "basis"}
      ]
    },
    "traub_kam": {
      "description": "同じ群を学習せずに KAM 縮約でまとめる基準。式から組むので項ライブラリは持たない。",
      "cell": "traub",
      "form": "hybrid",
      "target": "traub",
      "duration": 9000,
      "compressor": "kam",
      "rhs": "kam",
      "d": 1
    },
    "traub19": {
      "description": "19 区画の全軌道で学習する。どこを置換するかは系列（replace_targets）が決める。1 軌道を 1000 ms にして、総サンプル数を単一区画（9000 ms）と同じくらいにする。",
      "cell": "traub",
      "form": "hybrid",
      "target": "traub19",
      "duration": 1000,
      "library_specs": [
        {"type": "traub_gate_forward"},
        {"type": "traub_gate_backward"},
        {"type": "traub_gate_forward_product"},
        {"type": "traub_gate_backward_product"},
        {"type": "basis"}
      ]
    },
    "traub19_poster": {
      "description": "NEURO2026 のポスターの形。s, r も元の式で解き、残る 6 ゲートを縮める。ポスターは元の式で解く s, r のレート項も入れていたので、結果を変えないよう全ゲートの項を書く。",
      "cell": "traub",
      "form": "hybrid",
      "target": "traub19",
      "duration": 1000,
      "groups": [["M", "N", "C", "A", "H", "B"]],
      "library_specs": [
        {"type": "traub_gate_forward", "gates": "msncahrb"},
        {"type": "traub_gate_backward", "gates": "msncahrb"},
        {"type": "traub_gate_forward_product", "gates": "msncahrb"},
        {"type": "traub_gate_backward_product", "gates": "msncahrb"},
        {"type": "basis"}
      ]
    },
    "test_hh": {
      "description": "テストは形と有限性だけを見るので電流を 180 ms に縮め、決定的で速い PCA にする。",
      "cell": "hh",
      "target": "hh",
      "duration": 180,
      "groups": [["M", "H", "N"]],
      "compressor": "pca",
      "library_specs": [
        {"type": "hh_gate_forward"},
        {"type": "hh_gate_backward"},
        {"type": "hh_gate_forward_product"},
        {"type": "hh_gate_backward_product"},
        {"type": "basis"}
      ]
    },
    "test_traub": {
      "description": "テスト用の Traub 単一区画。電流を 180 ms に縮め、PCA で 5 本へ縮める。",
      "cell": "traub",
      "form": "hybrid",
      "target": "traub",
      "duration": 180,
      "compressor": "pca",
      "d": 5,
      "library_specs": [
        {"type": "traub_gate_forward"},
        {"type": "traub_gate_backward"},
        {"type": "traub_gate_forward_product"},
        {"type": "traub_gate_backward_product"},
        {"type": "basis"}
      ]
    }
  },
  "presets": {
    "traub_useMC19CompForTeachingData": {
      "description": "Ca 系（χ, q）だけを元の式で解き、残る 8 ゲートを潜在へ縮める。",
      "base": "traub19",
      "groups": [["M", "N", "C", "A", "H", "B", "S", "R"]],
      "compressor": "pca",
      "d": [6, 7, 8]
    },
    "poster_noCompression": {"description": "6 → 6 の可逆な PCA で、圧縮しないときの基準。", "base": "traub19_poster", "compressor": "pca", "d": 6},
    "poster_traub_pca": {"base": "traub19_poster", "compressor": "pca", "d": 5},
    "poster_traub_ae": {"base": "traub19_poster", "compressor": "ae", "d": 5},
    "grouped_hn_pca": {
      "description": "h, n を 1 本へ縮める。PCA の 2 本は 2 → 2 の可逆な変換で、圧縮しないときの基準。",
      "base": "traub_grouped",
      "groups": [["N", "H"]],
      "compressor": "pca",
      "d": [1, 2]
