  "series": {
    "traub_soma_dc": {
      "description": "単一区画の素の応答。テストが使う。",
      "spec": {
        "target": "traub",
        "current_type": "lin&steady",
        "dt": 0.01,
        "current_params": {"silence_duration": 10.0, "duration": 40.0, "value": 3.0},
        "stim": "soma"
      },
      "replace_targets": ["soma"],
      "param": null,
      "values": []
    },
    "traub_somastim": {
      "description": "単一区画を soma への定常電流で 0 から 10 µA/cm² の 5 点で掃引する。刺激前の静穏と本体の長さは ms で、掃引する値は Python の EvalSeries が点ごとに埋める。",
      "spec": {"target": "traub", "current_type": "lin&steady", "dt": 0.01, "current_params": {"silence_duration": 10.0, "duration": 300.0}, "stim": "soma"},
      "replace_targets": ["soma"],
      "param": "value",
      "values": [0, 2.5, 5, 7.5, 10]
    },
    "traub19_somastim": {
      "spec": {"target": "traub19", "current_type": "lin&steady", "dt": 0.01, "current_params": {"silence_duration": 10.0, "duration": 300.0}, "stim": "soma"},
      "replace_targets": ["soma"],
      "param": "value",
      "values": [0, 2.5, 5, 7.5, 10]
    },
    "traub19_dendstim": {
      "description": "c09 は soma の隣の apical の近位樹状突起で、電流が soma へ確実に伝わる。",
      "spec": {"target": "traub19", "current_type": "lin&steady", "dt": 0.01, "current_params": {"silence_duration": 10.0, "duration": 300.0}, "stim": "c09"},
      "replace_targets": ["soma"],
      "param": "value",
      "values": [0, 2.5, 5, 7.5, 10]
    },
    "traub19_somastim_allcomp": {
      "description": "somastim と置換範囲だけが違う。教師データの範囲（19 区画）と置換範囲を揃えた条件。traub19 の全区画（soma は 8 番）は宣言で綴り、形態から導かない。",
      "spec": {"target": "traub19", "current_type": "lin&steady", "dt": 0.01, "current_params": {"silence_duration": 10.0, "duration": 300.0}, "stim": "soma"},
      "replace_targets": ["c00", "c01", "c02", "c03", "c04", "c05", "c06", "c07", "soma", "c09", "c10", "c11", "c12", "c13", "c14", "c15", "c16", "c17", "c18"],
      "param": "value",
      "values": [0, 2.5, 5, 7.5, 10]
    }
  }
}
